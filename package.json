{
  "name": "sciolyguide",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck -w @sciolyguide/web",
    "validate:content": "node scripts/validate-registry.ts content/seasons/2027/events.yaml",
    "check": "npm run typecheck && npm run validate:content && npm test",
    "test": "npm test -w @sciolyguide/codebusters && npm test -w @sciolyguide/rocks-minerals",
    "build": "npm run build -w @sciolyguide/web"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "yaml": "^2.8.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
